# ─────────────────────────────────────────────
# life.os — Environment Variables
# Copy this to .env.local and fill in values
# ─────────────────────────────────────────────

# REQUIRED — https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# RECOMMENDED — https://fal.ai/dashboard/keys
# Primary AI video generation (Kling image-to-video / text-to-video)
# Falls back to DALL-E 3 image if not set
FAL_KEY=

# OPTIONAL — https://aistudio.google.com/app/apikey
# Reserved for Gemini video fallback (Veo)
GEMINI_API_KEY=

# OPTIONAL — https://elevenlabs.io/app/settings/api-keys
# Richer NPC voice. Falls back to OpenAI TTS, then browser TTS.
ELEVENLABS_API_KEY=
